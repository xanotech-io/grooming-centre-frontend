#!/usr/bin/env sh

# ─── Colors & symbols ────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

PASS="${GREEN}✔${RESET}"
FAIL="${RED}✖${RESET}"
INFO="${CYAN}›${RESET}"
WARN="${YELLOW}⚠${RESET}"

# ─── Header ──────────────────────────────────────────────────────────────────
echo ""
printf "${BOLD}${CYAN}  Pre-commit check${RESET}  ${DIM}grooming-centre${RESET}\n"
printf "${DIM}  ─────────────────────────────────────────${RESET}\n"
echo ""

# ─── Staged file detection ────────────────────────────────────────────────────
# BUG FIX: grep exits with code 1 when there are no matches. Without `|| true`
# the pipeline exit code leaks out of $() and can kill the script in strict
# POSIX sh before the empty-check is ever reached.
printf "  ${INFO} Checking staged files...\n"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null \
  | grep -E '\.(js|jsx)$' || true)

if [ -z "$STAGED" ]; then
  printf "  ${WARN}  No JS/JSX files staged — lint skipped.\n"
  echo ""
  printf "  ${PASS} ${BOLD}Nothing to lint. Commit is clean.${RESET}\n"
  echo ""
  exit 0
fi

# grep -c always exits 0; || true is a safety net for edge-case sh variants
FILE_COUNT=$(printf "%s\n" "$STAGED" | grep -c '.' || true)
printf "  ${PASS} ${FILE_COUNT} staged file(s) queued for linting.\n"
echo ""

# ─── ESLint via lint-staged ───────────────────────────────────────────────────
# BUG FIX: removed --quiet and 2>&1 redirection.
# --quiet suppressed all lint-staged output. 2>&1 swallowed stderr into the
# if-condition so errors were never printed. Now output flows straight to
# the terminal; we capture the exit code separately with $?.
printf "  ${INFO} Running ESLint on staged files...\n"
echo ""

npx lint-staged
LINT_EXIT=$?

if [ $LINT_EXIT -eq 0 ]; then
  printf "  ${DIM}─────────────────────────────────────────${RESET}\n"
  printf "  ${PASS} ${BOLD}${GREEN}All checks passed.${RESET} Committing...\n"
  echo ""
else
  echo ""
  printf "  ${DIM}─────────────────────────────────────────${RESET}\n"
  printf "  ${FAIL} ${BOLD}${RED}Commit blocked — ESLint found errors.${RESET}\n"
  echo ""
  printf "  ${YELLOW}How to fix:${RESET}\n"
  printf "  ${DIM}  1. Auto-fix  →  yarn lint:fix${RESET}\n"
  printf "  ${DIM}  2. Manual    →  review the errors printed above${RESET}\n"
  printf "  ${DIM}  3. Emergency →  git commit --no-verify  (use sparingly)${RESET}\n"
  echo ""
  exit 1
fi
